# ============================================================
# Cooperativa Nativaram — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores:
# cp .env.local.example .env.local
# ============================================================

# === Autenticação Administrativa & Conselho Gestor (Obrigatório em Produção) ===
# ADMIN_SECRET_KEY: Segredo HMAC-SHA256 para assinar tokens de sessão httpOnly
# ADMIN_MASTER_PASSWORD: Senha mestra para login do Conselho Gestor (adm-nativaram)
ADMIN_SECRET_KEY=gerar-chave-secreta-longa-32-caracteres
ADMIN_MASTER_PASSWORD=definir-senha-mestra-forte

# === Supabase (Persistência em Nuvem) ===
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave>
# SUPABASE_SERVICE_ROLE_KEY: somente servidor (NUNCA com prefixo NEXT_PUBLIC_).
# Necessária para gravar/ler cadastros protegidos por RLS (solicitacoes_homologacao etc.).
SUPABASE_SERVICE_ROLE_KEY=colar-a-service-role-key-do-painel-supabase

# === Domínio Institucional Base ===
NEXT_PUBLIC_SITE_URL=https://nativaramcoop.eco.br
